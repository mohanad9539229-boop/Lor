local function GetAimbotPart(char, preferred)
if not char then return nil end
preferred = preferred or CFG.AimbotBone or "Head"
if preferred == "Head" then
return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
elseif preferred == "Upper Body" or preferred == "Torso" then
return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end
return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end
local function IsAlive(player)
local c = player and player.Character
if not c then return false end
local h = c:FindFirstChildOfClass("Humanoid")
return h and h.Health > 0 and c:FindFirstChild("HumanoidRootPart") ~= nil
end
local function ShouldTarget(player)
if player == LocalPlayer or not IsAlive(player) then return false end
if CFG.AimbotTeamCheck and LocalPlayer.Team and player.Team and player.Team == LocalPlayer.Team then
return false
end
return true
end
local function W2S(pos)
local v, vis = Camera:WorldToViewportPoint(pos)
return Vector2.new(v.X, v.Y), vis, v.Z
end
local function FindBestTarget()
local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
local best, bestD = nil, math.huge
local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
local myPos = myRoot and myRoot.Position or Camera.CFrame.Position
for _, plr in ipairs(Players:GetPlayers()) do
if ShouldTarget(plr) then
local c = plr.Character
local root = c and c:FindFirstChild("HumanoidRootPart")
if root and (root.Position - myPos).Magnitude <= CFG.AimbotMaxDist then
local bone = GetAimbotPart(c, CFG.AimbotBone)
if bone then
local sp, vis = W2S(bone.Position)
if vis then
local d = (screenCenter - sp).Magnitude
if d <= CFG.AimbotFOV and d < bestD then
bestD = d
best = {player = plr, char = c, bone = bone}
end
end
end
end
end
end
return best
end
